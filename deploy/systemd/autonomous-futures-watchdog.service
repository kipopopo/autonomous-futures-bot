[Unit]
Description=Read-Only Health & Daily Risk Watchdog for Qualified Futures Runtime
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/autonomous-futures-bot/releases/qualified-runtime
Environment=PYTHONPATH=/opt/autonomous-futures-bot/releases/qualified-runtime/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/autonomous-futures-bot/.venv/bin/python scripts/check_qualified_runtime_health.py --storage-dir /opt/autonomous-futures-bot/runtime/qualified-testnet --check-systemd --write-report
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
