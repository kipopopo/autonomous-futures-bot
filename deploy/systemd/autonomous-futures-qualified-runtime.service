[Unit]
Description=Qualified Autonomous Futures Testnet Runtime
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autonomous-futures-bot/releases/qualified-runtime
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/autonomous-futures-bot/.env.qualified-runtime
ExecStart=/opt/autonomous-futures-bot/.venv/bin/python scripts/run_qualified_runtime.py --storage-dir /opt/autonomous-futures-bot/runtime/qualified-testnet --account-lease /opt/autonomous-futures-bot/runtime/qualified-testnet/account-writer.lock --equity-basis ${AFBOT_EQUITY_BASIS} --hawkes-calibration /opt/autonomous-futures-bot/releases/qualified-runtime/artifacts/qualification/runtime-microstructure/runtime-hawkes-calibration-20261013.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
